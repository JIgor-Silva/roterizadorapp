# Chaves das integrações externas (desenvolvimento e testes).
# Copie para .env e preencha:  cp .env.example .env
# O .env está no .gitignore — nunca commite chaves reais.
# Se uma variável ficar vazia, o app usa o valor de config/credentials.yml.enc (se existir).

# OpenRouteService — cálculo de rotas (https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=

# WeatherAPI — clima do dashboard (https://www.weatherapi.com/signup.aspx)
WEATHER_API_KEY=

# Opcional: URL base do OpenRouteService (padrão https://api.heigit.org/openrouteservice)
# ORS_BASE_URL=
